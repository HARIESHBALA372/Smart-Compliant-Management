# Frontend Production Environment Variables
# If deploying frontend with reverse proxy (e.g., Nginx in Docker Compose), use relative paths:
VITE_API_URL=/api
VITE_ML_API_URL=http://localhost:8000
VITE_WS_URL=/ws

# If deploying frontend separately (e.g., Vercel / Netlify / Cloudflare Pages) pointing to remote API:
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_ML_API_URL=https://ml.yourdomain.com
# VITE_WS_URL=wss://api.yourdomain.com/ws
