# Backend Production Environment Variables
PORT=4000
HOST="0.0.0.0"
ENVIRONMENT="production"

# Database Configuration (SQLite default with persistent storage path, or PostgreSQL)
DATABASE_URL="sqlite:////app/data/complaints.db"
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret key for JWT signing - generate using `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET="replace_with_a_secure_random_64_character_hex_key_in_production"
JWT_EXPIRES_DAYS=7

# Allowed CORS Origins (comma-separated domains)
CLIENT_URL="https://yourdomain.com,http://localhost:3000"

# Attachment uploads storage directory
UPLOAD_DIR="/app/uploads"

# ML Microservice internal connection URL
ML_SERVICE_URL="http://ml-service:8000"
ML_SERVICE_TIMEOUT_SECONDS=5.0
