DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_complaint_app"
JWT_SECRET="change_this_secret_to_a_long_random_string"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="smart-complaint-api"
JWT_AUDIENCE="smart-complaint-app"
PORT=5000
NODE_ENV="development"
UPLOAD_DIR="./uploads"
CLIENT_URL="http://localhost:3000"

# Redis (caching, background queues, distributed rate limiting).
# The API degrades gracefully and keeps working without Redis.
REDIS_ENABLED=true
REDIS_CONNECTION_STRING="redis://localhost:6379"

# Used by the test suite (Jest/Supertest). Create it with:
#   createdb smart_complaint_test    (or)    psql -c "CREATE DATABASE smart_complaint_test"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_complaint_test"

# ML microservice (FastAPI, see ../ml-service).
# Used to call complaint analysis endpoints from the API layer.
ML_SERVICE_URL="http://localhost:8000"

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Email channel (SMTP). Notification emails are skipped when SMTP_HOST is empty,
# so the app runs fine locally without a mail server.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@smartcomplaints.local"