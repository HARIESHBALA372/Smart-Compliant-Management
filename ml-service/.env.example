# Copy to .env and adjust as needed.
APP_NAME=Smart Complaint ML Service
APP_SERVICE_NAME=complaint-ml-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Model artifact paths (relative paths resolve against the service root).
MODEL_PATH=models/complaint_classifier.joblib
VECTORIZER_PATH=models/vectorizer.joblib
LABEL_ENCODER_PATH=models/category_encoder.joblib
PRIORITY_MODEL_PATH=models/priority_model.joblib
PRIORITY_VECTORIZER_PATH=models/priority_vectorizer.joblib
DUPLICATES_INDEX_PATH=models/duplicates_index.json
MODEL_VERSION=1.0.0

# Recommend the matching backend department for a complaint.
DEPARTMENT_MAPPING_PATH=config/department_mapping.json

# Duplicate detection.
DUPLICATE_THRESHOLD=0.85
# auto | sentence-transformers | tfidf (tfidf maps to the offline hashing fallback).
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_SIMILAR_RESULTS=5

# Web / security (comma-separated origins, or * to allow any).
CORS_ORIGINS=*
# Empty string disables authentication.
API_KEY=
API_KEY_HEADER=X-API-Key

# Runtime controls.
MAX_TEXT_LENGTH=2000
MAX_BATCH_SIZE=100
# Allow the legacy /retrain-model endpoint to run the offline training pipeline.
TRAINING_ENABLED=false